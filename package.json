{
  "name": "cqai-dsh-plugin-track",
  "version": "0.1.5",
  "description": "轨迹：二维与 3D 沙盘、卫星底图、分析编辑、SVG 标注和 AI 动画美化",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "src/",
    "tests/",
    "scripts/",
    "licenses/",
    "docs/",
    "cordis.patch.yml",
    "README.md",
    "PROVENANCE.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "BUILDING.md",
    "SOURCE-SNAPSHOT.json",
    "tsdown.config.ts",
    "tsconfig.json",
    "vitest.config.ts",
    "build-inputs/",
    ".yarnrc.yml",
    ".gitattributes"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "build": "tsdown && node scripts/verify-client-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:release": "node --test scripts/release-package-utils.test.mjs"
  },
  "dependencies": {
    "@panzoom/panzoom": "4.6.2",
    "chart.js": "^4.5.1",
    "chartjs-plugin-crosshair": "^2.0.0",
    "chartjs-plugin-zoom": "^2.2.0",
    "immer": "10.1.1",
    "maplibre-gl": "^5.24.0",
    "mediabunny": "1.24.2",
    "sharp": "0.35.5",
    "three": "^0.185.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.5-rc.1 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.5-rc.1 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.5-rc.1 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.5-rc.1 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-home-paths": "^0.1.5-rc.1 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.5-rc.1 || ^0.2.0-rc.2",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "@types/three": "^0.185.0",
    "jsdom": "29.1.1",
    "react": "^18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.2",
    "typescript": "~5.7.2",
    "vite": "8.2.1",
    "vitest": "4.1.8"
  },
  "repository": {
    "url": "git+https://github.com/g-dxw/dsh-plugin-track.git",
    "type": "git"
  },
  "homepage": "https://github.com/g-dxw/dsh-plugin-track#readme",
  "bugs": {
    "url": "https://github.com/g-dxw/dsh-plugin-track/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "tag": "latest",
    "access": "public"
  },
  "trackSource": {
    "baseCommit": "2d5ea48ee0ed1a547992c844794c4936e84c7877",
    "dirty": false,
